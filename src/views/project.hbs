<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Project Portfolio</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/assets/css/project.css" />
  </head>
  <body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
      <div class="container">
        <a class="navbar-brand" href="/">
          <img src="/assets/images/logo.svg" alt="Logo" class="logo-img" />
        </a>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a class="nav-link" href="/">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link active" href="/project">My Project</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/contact">Contact</a>
            </li>
          </ul>

          <div class="d-flex align-items-center gap-2">
            <button class="btn btn-dark btn-sm">Contact Me</button>

            {{#if userData}}
              <div class="user-info">
                <div class="user-avatar">
                  {{userData.[0]}}
                </div>
                <span class="user-name">{{userData}}</span>
              </div>

              <a href="/logout" class="btn btn-danger btn-sm">Logout</a>
            {{else}}
              <a class="btn btn-primary btn-sm" href="/login">Login</a>
              <a class="btn btn-warning btn-sm" href="/register">Register</a>
            {{/if}}
          </div>
        </div>
      </div>
    </nav>

    <!-- FORM SECTION -->
    <div class="form-section">
      <div class="container">
        <div class="form-wrapper">
          <h2 class="text-center">ADD MY PROJECT</h2>

          <!-- TAMBAH enctype -->
          <form method="POST" action="/project" enctype="multipart/form-data">
            <div class="mb-3">
              <label class="form-label">Project Name</label>
              <input type="text" class="form-control" name="title" required />
            </div>

            <div class="row mb-3">
              <div class="col-md-6">
                <label class="form-label">Start Date</label>
                <input
                  type="date"
                  class="form-control"
                  name="startDate"
                  required
                />
              </div>
              <div class="col-md-6">
                <label class="form-label">End Date</label>
                <input
                  type="date"
                  class="form-control"
                  name="endDate"
                  required
                />
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label">Description</label>
              <textarea
                class="form-control"
                name="description"
                required
              ></textarea>
            </div>

            <!-- IMAGE UPLOAD -->
            <div class="mb-3">
              <label class="form-label">Upload Image</label>
              <input
                type="file"
                class="form-control"
                name="image"
                accept="image/*"
              />
            </div>

            <!-- TECHNOLOGIES -->
            <div class="mb-3">
              <label class="form-label">Technologies</label>
              <div class="row">
                {{#each technologies}}
                  <div class="col-6 col-md-3 mb-2">
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        name="technologies"
                        value="{{this.id}}"
                        id="tech{{this.id}}"
                      />
                      <label class="form-check-label" for="tech{{this.id}}">
                        {{this.tech_name}}
                      </label>
                    </div>
                  </div>
                {{/each}}
              </div>
            </div>

            <div class="text-end">
              <button type="submit" class="submit-btn">submit</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- PROJECTS SECTION -->
    <div class="container">
      <div class="projects-section">
        <h2 class="text-center">MY PROJECT</h2>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
          {{#each projects}}
            <div class="col">
              <div class="project-card">

                <!-- IMAGE / FALLBACK HURUF -->
                {{#if this.image}}
                  <img
                    src="/uploads/{{this.image}}"
                    style="height:160px; width:100%; object-fit:cover; border-top-left-radius:16px; border-top-right-radius:16px;"
                  />
                {{else}}
                  <div class="project-image">{{this.title.[0]}}</div>
                {{/if}}

                <div class="p-3">
                  <div class="project-title">{{this.title}}</div>
                  <div class="project-duration">
                    {{formatDate this.start_date}}
                    -
                    {{formatDate this.end_date}}
                  </div>
                  <div class="project-description">
                    {{this.description}}
                  </div>

                  <div class="mb-3">
                    {{#each this.technologies}}
                      <span class="tech-badge">{{this}}</span>
                    {{/each}}
                  </div>

                  <a
                    href="/edit-project/{{this.id}}"
                    class="btn btn-warning btn-sm w-100 mb-2"
                  >Edit</a>
                  <a
                    href="/delete-project/{{this.id}}"
                    class="btn btn-danger btn-sm w-100"
                  >Delete</a>
                </div>
              </div>
            </div>
          {{/each}}
        </div>
      </div>
    </div>

    <!-- Bootstrap JS -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
    ></script>
  </body>
</html>