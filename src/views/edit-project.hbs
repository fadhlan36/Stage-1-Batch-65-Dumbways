<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Project</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/project.css" />
  </head>

  <body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white">
      <div class="container">
        <a class="navbar-brand" href="/">
          <img src="../assets/images/logo.svg" alt="Logo" class="logo-img" />
        </a>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a class="nav-link" href="/">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link active" href="/project">My Project</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/contact">Contact</a>
            </li>
          </ul>

          <button class="btn btn-dark btn-sm contact-btn">Contact Me</button>
        </div>
      </div>
    </nav>

    <!-- FORM -->
    <div class="form-section">
      <div class="container">
        <div class="form-wrapper">
          <h2 class="text-center">EDIT PROJECT</h2>

          <form method="POST" action="/edit-project/{{project.id}}">
            
            <!-- TITLE -->
            <div class="mb-3">
              <label class="form-label">Project Name</label>
              <input
                type="text"
                class="form-control"
                name="title"
                value="{{project.title}}"
                required
              />
            </div>

            <!-- DATE -->
            <div class="row mb-3">
              <div class="col-md-6">
                <label class="form-label">Start Date</label>
                <input
                  type="date"
                  class="form-control"
                  name="startDate"
                  value="{{formatDate project.start_date}}"
                  required
                />
              </div>

              <div class="col-md-6">
                <label class="form-label">End Date</label>
                <input
                  type="date"
                  class="form-control"
                  name="endDate"
                  value="{{formatDate project.end_date}}"
                  required
                />
              </div>
            </div>

            <!-- DESCRIPTION -->
            <div class="mb-3">
              <label class="form-label">Description</label>
              <textarea
                class="form-control"
                name="description"
                required
              >{{project.description}}</textarea>
            </div>

            <!-- TECHNOLOGIES -->
            <div class="mb-3">
              <label class="form-label">Technologies</label>
              <div class="row">

                {{#each technologies}}
                <div class="col-6 col-md-3 mb-2">
                  <div class="form-check">
                    <input
                      class="form-check-input"
                      type="checkbox"
                      name="technologies"
                      value="{{this.id}}"
                      {{#if (includes ../selectedTech this.id)}}checked{{/if}}
                    />
                    <label class="form-check-label">
                      {{this.tech_name}}
                    </label>
                  </div>
                </div>
                {{/each}}

              </div>
            </div>

            <!-- BUTTON -->
            <div class="text-end">
              <button type="submit" class="btn btn-dark">
                Update Project
              </button>
            </div>

          </form>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
